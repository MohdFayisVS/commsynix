{
  "name": "commsynix",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commsynix-cms",
      "database_id": "e1faff13-7889-41a3-8433-c8c58aabf94f"
    }
  ],
  "keep_vars": true
}